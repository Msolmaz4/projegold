{
  "compilerOptions": {
    "target": "ESNext",
    "useDefineForClassFields": true,
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "esModuleInterop": true,
    "jsx": "react-jsx",

    /* Linting - Hataları görmezden gel */
    "strict": false,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": false,

    "paths": {
      "authentication": ["./src/auth"],
      "components": ["./src/components"],
      "config": ["./src/config"],
      "context": ["./src/context"],
      "core": ["./src/core"],
      "hooks": ["./src/hooks"],
      "icons": ["./src/icons"],
      "layout": ["./src/layout"],
      "layout/*": ["./src/layout/*"],
      "modules/*": ["./src/modules/*"],
      "options": ["./src/options"],
      "queryClient": ["./src/queryClient.ts"],
      "routes": ["./src/routes"],
      "types": ["./src/types"],
      "utils": ["./src/utils"],
      "utils/*": ["./src/utils/*"],
      "$amplify/*": ["../.amplify/generated/*"]
    }
  },
  "include": ["src"],
  "exclude": ["node_modules", "amplify", "amplify/**/*", ".amplify/**/*"],
  "files": [],
  "references": [{ "path": "./tsconfig.node.json" }]
}
